
<%- include('../partials/layout-start', {
  pageTitle: 'Suppliers',
  activePage: 'suppliers'
}) %>

<!-- Page Heading -->
<div class="page-heading">

  <div>
    <div class="eyebrow">CONTACTS</div>

    <h1>Suppliers</h1>

    <p>Manage supplier details and keep your supply chain close.</p>
  </div>

  <button
    class="btn btn-primary"
    data-open-modal="supplierModal"
  >
    <i data-lucide="plus"></i>
    Add supplier
  </button>

</div>

<!-- Suppliers Grid -->
<div class="supplier-grid">

  <% const supplierRows = (typeof suppliers !== 'undefined' && Array.isArray(suppliers))
    ? suppliers
    : []; %>

  <% if (supplierRows.length) { %>

    <% supplierRows.forEach(supplier => { %>

      <!-- Supplier Card -->
      <article class="panel supplier-card">

        <!-- Supplier Header -->
        <div class="supplier-top">

          <span class="supplier-logo cat-blue">
            <%= (supplier.company_name || 'S').slice(0, 2).toUpperCase() %>
          </span>

          <button
            type="button"
            class="icon-button"
            aria-label="Edit supplier"
            data-open-modal="editSupplierModal-<%= supplier.id %>"
          >
            <i data-lucide="pencil"></i>
          </button>

        </div>

        <!-- Supplier Information -->
        <h3><%= supplier.company_name %></h3>

        <span class="category-tag">
          Supplier
        </span>

        <!-- Contact Information -->
        <div class="supplier-contact">

          <div>
            <i data-lucide="user-round"></i>
            <%= supplier.contact_name || '—' %>
          </div>

          <div>
            <i data-lucide="mail"></i>
            <%= supplier.email || '—' %>
          </div>

          <div>
            <i data-lucide="phone"></i>
            <%= supplier.phone || '—' %>
          </div>

        </div>

        <!-- View Supplier Button -->
        <!-- Supplier Actions -->
<div class="supplier-actions">

    <!-- View Supplier -->
    <a
        href="/suppliers/<%= supplier.id %>"
        class="btn btn-light btn-block"
    >
        View supplier
    </a>

    <!-- Delete Supplier -->
    <form
        action="/suppliers/<%= supplier.id %>/delete"
        method="POST"
        onsubmit="return confirm('Are you sure you want to delete this supplier?');"
    >
        <button
            type="submit"
            class="btn btn-light"
            aria-label="Delete supplier"
        >
            <i data-lucide="trash-2"></i>
        </button>
    </form>

</div>

      </article>

<!-- Edit Supplier Modal -->
<div
  class="modal-backdrop"
  id="editSupplierModal-<%= supplier.id %>"
>

  <div class="modal">

    <!-- Modal Header -->
    <div class="modal-head">

            <div>
                <h2>Edit supplier</h2>
                <p>Update supplier information.</p>
            </div>

            <button class="icon-button" data-close-modal>
                <i data-lucide="x"></i>
            </button>

            </div>

            <!-- Update Supplier Form -->
            <form
            action="/suppliers/<%= supplier.id %>/update"
            method="POST"
            >

            <!-- Company Name -->
            <div class="field">

                <label>Company name</label>

                <input
                type="text"
                name="company_name"
                value="<%= supplier.company_name %>"
                placeholder="Enter company name"
                required
                >

            </div>

            <!-- Contact Name -->
            <div class="field">

                <label>Contact name</label>

                <input
                type="text"
                name="contact_name"
                value="<%= supplier.contact_name || '' %>"
                placeholder="Enter contact person name"
                >

            </div>

            <!-- Email -->
            <div class="field">

                <label>Email</label>

                <input
                type="email"
                name="email"
                value="<%= supplier.email || '' %>"
                placeholder="Enter email address"
                >

            </div>

            <!-- Phone -->
            <div class="field">

                <label>Phone</label>

                <input
                type="text"
                name="phone"
                value="<%= supplier.phone || '' %>"
                placeholder="Enter phone number"
                >

            </div>

            <!-- Address -->
            <div class="field">

                <label>Address</label>

                <textarea
                name="address"
                rows="3"
                placeholder="Enter supplier address..."
                ><%= supplier.address || '' %></textarea>

            </div>

            <!-- Modal Actions -->
            <div class="modal-actions">

                <button
                type="button"
                class="btn btn-light"
                data-close-modal
                >
                Cancel
                </button>

                <button type="submit" class="btn btn-primary">
                Save changes
                </button>

            </div>

            </form>

        </div>

        </div>

    <% }) %>

  <% } else { %>

    <!-- Empty State -->
    <div class="panel empty-state grid-empty">

      <span class="empty-icon">
        <i data-lucide="truck"></i>
      </span>

      <strong>No suppliers yet</strong>

      <p>Supplier records will appear here when added.</p>

    </div>

  <% } %>

</div>


<!-- Add Supplier Modal -->
<div class="modal-backdrop" id="supplierModal">

  <div class="modal">

    <!-- Modal Header -->
        <div class="modal-head">

        <div>
            <h2>Add supplier</h2>
            <p>Add a new supplier to your supply chain.</p>
        </div>

        <button class="icon-button" data-close-modal>
            <i data-lucide="x"></i>
        </button>

        </div>

        <!-- Create Supplier Form -->
        <form action="/suppliers" method="POST">

        <!-- Company Name -->
        <div class="field">

            <label>Company name</label>

            <input
            type="text"
            name="company_name"
            placeholder="Enter company name"
            required
            >

        </div>

        <!-- Contact Name -->
        <div class="field">

            <label>Contact name</label>

            <input
            type="text"
            name="contact_name"
            placeholder="Enter contact person name"
            >

        </div>

        <!-- Email -->
        <div class="field">

            <label>Email</label>

            <input
            type="email"
            name="email"
            placeholder="Enter email address"
            >

        </div>

        <!-- Phone -->
        <div class="field">

            <label>Phone</label>

            <input
            type="text"
            name="phone"
            placeholder="Enter phone number"
            >

        </div>

        <!-- Address -->
        <div class="field">

            <label>Address</label>

            <textarea
            name="address"
            rows="3"
            placeholder="Enter supplier address..."
            ></textarea>

        </div>

        <!-- Modal Actions -->
        <div class="modal-actions">

            <button
            type="button"
            class="btn btn-light"
            data-close-modal
            >
            Cancel
            </button>

            <button type="submit" class="btn btn-primary">
            Create supplier
            </button>

        </div>

        </form>

    </div>

    </div>


<%- include('../partials/layout-end') %>
