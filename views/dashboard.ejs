<%- include('partials/layout-start', {pageTitle: 'Overview', activePage: 'dashboard'}) %>
<div class="page-heading"><div><div class="eyebrow">WORKSPACE OVERVIEW</div><h1>Welcome to Stockwise <span class="wave">✦</span></h1><p>Here's an overview of your inventory and activity.</p></div><div class="heading-actions"><button class="btn btn-light" type="button"><i data-lucide="download"></i> Export report</button><a class="btn btn-primary" href="/products/new"><i data-lucide="plus"></i> Add product</a></div></div>
<section class="stats-grid">
  <article class="stat-card"><div class="stat-top"><span>Total products</span><span class="stat-icon blue"><i data-lucide="package"></i></span></div><div class="stat-value">—</div><div class="stat-foot">Awaiting inventory data</div></article>
  <article class="stat-card"><div class="stat-top"><span>Total inventory value</span><span class="stat-icon violet"><i data-lucide="wallet"></i></span></div><div class="stat-value">—</div><div class="stat-foot">Awaiting inventory data</div></article>
  <article class="stat-card"><div class="stat-top"><span>Low stock items</span><span class="stat-icon orange"><i data-lucide="alert-triangle"></i></span></div><div class="stat-value">—</div><div class="stat-foot">Awaiting inventory data</div></article>
  <article class="stat-card"><div class="stat-top"><span>Orders</span><span class="stat-icon green"><i data-lucide="shopping-cart"></i></span></div><div class="stat-value">—</div><div class="stat-foot">Awaiting order data</div></article>
</section>
<section class="dashboard-grid">
  <article class="panel sales-panel"><div class="panel-header"><div><h2>Sales overview</h2><p>Revenue performance will appear here.</p></div><span class="select-button">Sales summary</span></div><div class="empty-state compact"><span class="empty-icon"><i data-lucide="chart-no-axes-combined"></i></span><strong>No sales data yet</strong><p>Sales activity will be displayed after orders are recorded.</p></div></article>
  <article class="panel stock-panel"><div class="panel-header"><div><h2>Stock by category</h2><p>Product distribution</p></div></div><div class="empty-state compact"><span class="empty-icon"><i data-lucide="chart-pie"></i></span><strong>No category data yet</strong><p>Category distribution will appear here.</p></div></article>
</section>
<section class="panel table-panel"><div class="panel-header"><div><h2>Recent orders</h2><p>Your latest customer transactions.</p></div><a class="text-link" href="/orders">View all orders <i data-lucide="arrow-up-right"></i></a></div><div class="empty-state"><span class="empty-icon"><i data-lucide="inbox"></i></span><strong>No orders yet</strong><p>Orders will appear here after you create them.</p><a href="/orders" class="btn btn-light">Go to orders</a></div></section>
<%- include('partials/layout-end') %>
