
<%- include('../partials/layout-start', {
  pageTitle: 'Categories',
  activePage: 'categories'
}) %>

<!-- Page Heading -->
<div class="page-heading">
  <div>
    <div class="eyebrow">CATALOG</div>
    <h1>Categories</h1>
    <p>Organize your products into easy-to-manage groups.</p>
  </div>

  <button class="btn btn-primary" data-open-modal="categoryModal">
    <i data-lucide="plus"></i>
    Add category
  </button>
</div>

<!-- Categories Grid -->
<div class="category-grid">

  <% const categoryRows = (typeof categories !== 'undefined' && Array.isArray(categories)) ? categories : []; %>

  <% if (categoryRows.length) { %>

    <% categoryRows.forEach(category => { %>

      <!-- Category Card -->
      <article class="panel category-card">

        <div class="category-card-top">
          <span class="category-icon cat-blue">
            <i data-lucide="shapes"></i>
          </span>

          <!-- Category Actions -->
            <div style="display: flex; gap: 8px;">

            <!-- Edit Button -->
            <button
                type="button"
                class="icon-button"
                aria-label="Edit category"
                data-open-modal="editCategoryModal-<%= category.id %>"
            >
                <i data-lucide="pencil"></i>
            </button>

            <!-- Delete Form -->
            <form
                action="/categories/<%= category.id %>/delete"
                method="POST"
                onsubmit="return confirm('Are you sure you want to delete this category?');"
            >
                <button
                type="submit"
                class="icon-button"
                aria-label="Delete category"
                >
                <i data-lucide="trash-2"></i>
                </button>
            </form>

            </div>
        </div>

        <h3><%= category.name %></h3>

        <p><%= category.description || 'No description' %></p>

        <div class="category-card-bottom">

          <strong>
            <%= category.productCount != null ? category.productCount : '—' %>
            <small>products</small>
          </strong>

          <a href="/products">
            View products
            <i data-lucide="arrow-up-right"></i>
          </a>

        </div>

      </article>

      <!-- Edit Category Modal -->
      <div
        class="modal-backdrop"
        id="editCategoryModal-<%= category.id %>"
      >

        <div class="modal">

          <div class="modal-head">
            <div>
              <h2>Edit category</h2>
              <p>Update category information.</p>
            </div>

            <button class="icon-button" data-close-modal>
              <i data-lucide="x"></i>
            </button>
          </div>

          <!-- Edit Form -->
          <form
            action="/categories/<%= category.id %>/update"
            method="POST"
          >

            <div class="field">
              <label>Category name</label>

              <input
                type="text"
                name="name"
                value="<%= category.name %>"
                placeholder="Enter category name"
                required
              >
            </div>

            <div class="field">
              <label>Description</label>

              <textarea
                name="description"
                rows="3"
                placeholder="Short description..."
              ><%= category.description || '' %></textarea>
            </div>

            <div class="modal-actions">

              <button
                type="button"
                class="btn btn-light"
                data-close-modal
              >
                Cancel
              </button>

              <button type="submit" class="btn btn-primary">
                Save changes
              </button>

            </div>

          </form>

        </div>

      </div>

    <% }) %>

  <% } else { %>

    <!-- Empty State -->
    <div class="panel empty-state grid-empty">

      <span class="empty-icon">
        <i data-lucide="shapes"></i>
      </span>

      <strong>No categories yet</strong>

      <p>Create your first category to organize products.</p>

    </div>

  <% } %>

</div>

<!-- Add Category Modal -->
<div class="modal-backdrop" id="categoryModal">

  <div class="modal">

    <div class="modal-head">
      <div>
        <h2>Add category</h2>
        <p>Create a new product category.</p>
      </div>

      <button class="icon-button" data-close-modal>
        <i data-lucide="x"></i>
      </button>
    </div>

    <!-- Create Form -->
    <form action="/categories" method="POST">

      <div class="field">
        <label>Category name</label>

        <input
          type="text"
          name="name"
          placeholder="Enter category name"
          required
        >
      </div>

      <div class="field">
        <label>Description</label>

        <textarea
          name="description"
          rows="3"
          placeholder="Short description..."
        ></textarea>
      </div>

      <div class="modal-actions">

        <button
          type="button"
          class="btn btn-light"
          data-close-modal
        >
          Cancel
        </button>

        <button type="submit" class="btn btn-primary">
          Create category
        </button>

      </div>

    </form>

  </div>

</div>

<%- include('../partials/layout-end') %>
