<%- include('../partials/layout-start', {pageTitle: 'Customers', activePage: 'customers'}) %>
<div class="page-heading"><div><div class="eyebrow">CONTACTS</div><h1>Customers</h1><p>Keep customer information organized in one place.</p></div><button class="btn btn-primary"><i data-lucide="plus"></i> Add customer</button></div>
<section class="panel table-panel"><div class="toolbar"><label class="table-search"><i data-lucide="search"></i><input type="search" placeholder="Search customers..."></label><button class="btn btn-light"><i data-lucide="list-filter"></i> Filter</button></div><div class="table-wrap"><table><thead><tr><th>CUSTOMER</th><th>EMAIL</th><th>PHONE</th><th>ORDERS</th><th>TOTAL SPENT</th><th></th></tr></thead><tbody><% const customerRows = (typeof customers !== 'undefined' && Array.isArray(customers)) ? customers : []; %><% if (customerRows.length) { customerRows.forEach(customer => { %><tr><td><div class="person-cell"><span class="avatar avatar-blue"><%= (customer.name || 'C').slice(0,1).toUpperCase() %></span><strong><%= customer.name %></strong></div></td><td><%= customer.email || '—' %></td><td><%= customer.phone || '—' %></td><td><%= customer.orderCount != null ? customer.orderCount : '—' %></td><td class="amount"><%= customer.totalSpent != null ? customer.totalSpent : '—' %></td><td><button class="icon-button"><i data-lucide="more-horizontal"></i></button></td></tr><% }) } else { %><tr><td colspan="6"><div class="table-empty"><strong>No customers yet</strong><span>Customer records will appear here when added.</span></div></td></tr><% } %></tbody></table></div></section>
<%- include('../partials/layout-end') %>
