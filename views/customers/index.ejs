
<%- include('../partials/layout-start', {
  pageTitle: 'Customers',
  activePage: 'customers'
}) %>

<!-- Page Heading -->
<div class="page-heading">
  <div>
    <div class="eyebrow">CONTACTS</div>
    <h1>Customers</h1>
    <p>Keep customer information organized in one place.</p>
  </div>

  <button
    type="button"
    class="btn btn-primary"
    data-open-modal="customerModal"
  >
    <i data-lucide="plus"></i>
    Add customer
  </button>
</div>

<!-- Customers Table -->
<section class="panel table-panel">

  <div class="toolbar">
    <label class="table-search">
      <i data-lucide="search"></i>
      <input
        type="search"
        placeholder="Search customers..."
      >
    </label>

    <button type="button" class="btn btn-light">
      <i data-lucide="list-filter"></i>
      Filter
    </button>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>CUSTOMER</th>
          <th>EMAIL</th>
          <th>PHONE</th>
          <th>ORDERS</th>
          <th>TOTAL SPENT</th>
          <th></th>
        </tr>
      </thead>

      <tbody>

        <% const customerRows = (typeof customers !== 'undefined' && Array.isArray(customers)) ? customers : []; %>

        <% if (customerRows.length) { %>

          <% customerRows.forEach(customer => { %>

            <tr>
              <td>
                <div class="person-cell">
                  <span class="avatar avatar-blue">
                    <%= (customer.name || 'C').slice(0, 1).toUpperCase() %>
                  </span>

                  <strong><%= customer.name %></strong>
                </div>
              </td>

              <td><%= customer.email || '—' %></td>

              <td><%= customer.phone || '—' %></td>

              <!-- Deferred until Orders implementation -->
              <td>—</td>

              <!-- Deferred until Orders implementation -->
              <td class="amount">—</td>

              <td>
                <a
                    href="/customers/<%= customer.id %>"
                    class="icon-button"
                    aria-label="View customer details"
            >
                    <i data-lucide="eye"></i>
                </a>
              </td>
            </tr>

          <% }) %>

        <% } else { %>

          <tr>
            <td colspan="6">
              <div class="table-empty">
                <strong>No customers yet</strong>
                <span>Customer records will appear here when added.</span>
              </div>
            </td>
          </tr>

        <% } %>

      </tbody>
    </table>
  </div>

</section>


<!-- Add Customer Modal -->
<div class="modal-backdrop" id="customerModal">

  <div class="modal">

    <div class="modal-head">
      <div>
        <h2>Add customer</h2>
        <p>Create a new customer record.</p>
      </div>

      <button class="icon-button" type="button" data-close-modal>
        <i data-lucide="x"></i>
      </button>
    </div>

    <!-- Create Customer Form -->
    <form action="/customers" method="POST">

      <div class="field">
        <label>Customer name</label>

        <input
          type="text"
          name="name"
          placeholder="Enter customer name"
          required
        >
      </div>

      <div class="field">
        <label>Email</label>

        <input
          type="email"
          name="email"
          placeholder="Enter customer email"
        >
      </div>

      <div class="field">
        <label>Phone</label>

        <input
          type="text"
          name="phone"
          placeholder="Enter phone number"
        >
      </div>

      <div class="field">
        <label>Address</label>

        <textarea
          name="address"
          rows="3"
          placeholder="Enter customer address..."
        ></textarea>
      </div>

      <div class="modal-actions">

        <button
          type="button"
          class="btn btn-light"
          data-close-modal
        >
          Cancel
        </button>

        <button type="submit" class="btn btn-primary">
          Create customer
        </button>

      </div>

    </form>

  </div>

</div>


<%- include('../partials/layout-end') %>
