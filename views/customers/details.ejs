
<%- include('../partials/layout-start', {
  pageTitle: 'Customer Details',
  activePage: 'customers'
}) %>

<!-- Page Heading -->
<div class="page-heading">
    <form
        action="/customers/<%= customer.id %>/delete"
        method="POST"
        onsubmit="return confirm('Are you sure you want to delete this customer?');"
        >
        <button type="submit" class="btn btn-danger">
            <i data-lucide="trash-2"></i>
            Delete Customer
        </button>
    </form>
  <div>
    <div class="eyebrow">CUSTOMER PROFILE</div>
    <h1>Customer Details</h1>
    <p>View customer contact information.</p>
  </div>

  <div style="display: flex; gap: 10px;">
    <a href="/customers" class="btn btn-light">
      <i data-lucide="arrow-left"></i>
      Back to customers
    </a>

    <button
      type="button"
      class="btn btn-primary"
      data-open-modal="editCustomerModal"
    >
      <i data-lucide="pencil"></i>
      Edit Customer
    </button>
  </div>
</div>

<!-- Customer Information -->
<section class="panel" style="padding: 24px;">

  <div class="person-cell" style="margin-bottom: 24px;">
    <span class="avatar avatar-blue" style="width: 56px; height: 56px; font-size: 22px;">
      <%= (customer.name || 'C').slice(0, 1).toUpperCase() %>
    </span>

    <div>
      <h2 style="margin: 0;"><%= customer.name %></h2>
      <span class="eyebrow">CUSTOMER #<%= customer.id %></span>
    </div>
  </div>

  <div class="detail-grid">

    <div class="field">
      <label>Email</label>
      <p><%= customer.email || 'Not provided' %></p>
    </div>

    <div class="field">
      <label>Phone</label>
      <p><%= customer.phone || 'Not provided' %></p>
    </div>

    <div class="field">
      <label>Address</label>
      <p><%= customer.address || 'Not provided' %></p>
    </div>

    <div class="field">
      <label>Created At</label>
      <p><%= customer.createdAt ? customer.createdAt.toLocaleDateString() : '—' %></p>
    </div>

  </div>

</section>

<!-- Edit Customer Modal -->
<div class="modal-backdrop" id="editCustomerModal">
  <div class="modal">
    <div class="modal-head">
      <div>
        <h2>Edit customer</h2>
        <p>Update customer information.</p>
      </div>

      <button class="icon-button" type="button" data-close-modal>
        <i data-lucide="x"></i>
      </button>
    </div>

    <form action="/customers/<%= customer.id %>/update" method="POST">
      <div class="field">
        <label>Customer name</label>
        <input
          type="text"
          name="name"
          value="<%= customer.name %>"
          placeholder="Enter customer name"
          required
        >
      </div>

      <div class="field">
        <label>Email</label>
        <input
          type="email"
          name="email"
          value="<%= customer.email || '' %>"
          placeholder="Enter customer email"
        >
      </div>

      <div class="field">
        <label>Phone</label>
        <input
          type="text"
          name="phone"
          value="<%= customer.phone || '' %>"
          placeholder="Enter phone number"
        >
      </div>

      <div class="field">
        <label>Address</label>
        <textarea
          name="address"
          rows="3"
          placeholder="Enter customer address..."
        ><%= customer.address || '' %></textarea>
      </div>

      <div class="modal-actions">
        <button type="button" class="btn btn-light" data-close-modal>
          Cancel
        </button>

        <button type="submit" class="btn btn-primary">
          Save changes
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/layout-end') %>
