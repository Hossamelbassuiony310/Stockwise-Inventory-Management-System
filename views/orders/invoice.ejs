<%- include('../partials/layout-start', {pageTitle: 'Invoice preview', activePage: 'orders'}) %>
<div class="page-heading no-print"><div><div class="eyebrow">ORDERS / INVOICE</div><h1>Invoice preview</h1><p>Review invoice details before printing.</p></div><div class="heading-actions"><a href="/orders" class="btn btn-light"><i data-lucide="arrow-left"></i> Back</a><button class="btn btn-primary" onclick="window.print()"><i data-lucide="printer"></i> Print invoice</button></div></div>
<% const invoiceOrder = (typeof order !== 'undefined' && order) ? order : {}; const invoiceItems = Array.isArray(invoiceOrder.items) ? invoiceOrder.items : []; %>
<article class="invoice-sheet"><div class="invoice-head"><div class="brand invoice-brand"><span class="brand-mark"><i data-lucide="boxes"></i></span><span>stock<span class="brand-accent">wise</span><small>INVENTORY MANAGEMENT</small></span></div><div class="invoice-title"><h2>INVOICE</h2><strong><%= invoiceOrder.orderNumber || '—' %></strong></div></div><div class="invoice-meta"><div><small>BILLED TO</small><strong><%= invoiceOrder.customerName || 'Customer name' %></strong><span><%= invoiceOrder.customerEmail || 'Customer email' %></span><span><%= invoiceOrder.customerAddress || 'Customer address' %></span></div><div><small>INVOICE DETAILS</small><strong>Issue date: <%= invoiceOrder.createdAt || '—' %></strong><span>Status: <%= invoiceOrder.status || '—' %></span></div></div><table class="invoice-table"><thead><tr><th>ITEM DESCRIPTION</th><th>QTY</th><th>UNIT PRICE</th><th>TOTAL</th></tr></thead><tbody><% if (invoiceItems.length) { invoiceItems.forEach(item => { %><tr><td><strong><%= item.productName || '—' %></strong><small><%= item.sku || '' %></small></td><td><%= item.quantity %></td><td><%= item.unitPrice %></td><td><%= item.total %></td></tr><% }) } else { %><tr><td colspan="4" class="invoice-empty">No invoice items available.</td></tr><% } %></tbody></table><div class="invoice-bottom"><div class="invoice-note"><strong>Thank you for your business!</strong><p>Contact us if you have any questions about this invoice.</p></div><div class="totals"><div><span>Subtotal</span><strong><%= invoiceOrder.subtotal != null ? invoiceOrder.subtotal : '—' %></strong></div><div><span>Discount</span><strong><%= invoiceOrder.discount != null ? invoiceOrder.discount : '—' %></strong></div><div class="grand-total"><span>Total amount</span><strong><%= invoiceOrder.total != null ? invoiceOrder.total : '—' %></strong></div></div></div><div class="invoice-footer">Stockwise Inventory Management <span>Thank you for choosing us.</span></div></article>
<%- include('../partials/layout-end') %>
