<%- include('../partials/layout-start', {pageTitle: 'Orders', activePage: 'orders'}) %>
<div class="page-heading"><div><div class="eyebrow">SALES</div><h1>Orders</h1><p>View and manage customer orders.</p></div><button class="btn btn-primary"><i data-lucide="plus"></i> Create order</button></div>
<section class="panel table-panel"><div class="toolbar"><label class="table-search"><i data-lucide="search"></i><input placeholder="Search order ID or customer..."></label><button class="btn btn-light"><i data-lucide="calendar"></i> Date range</button><button class="btn btn-light"><i data-lucide="list-filter"></i> Status</button></div><div class="table-wrap"><table><thead><tr><th>ORDER ID</th><th>CUSTOMER</th><th>DATE</th><th>ITEMS</th><th>TOTAL</th><th>STATUS</th><th></th></tr></thead><tbody><% const orderRows = (typeof orders !== 'undefined' && Array.isArray(orders)) ? orders : []; %><% if (orderRows.length) { orderRows.forEach(order => { %><tr><td><a class="order-id" href="/orders/<%= order.id %>"><strong><%= order.orderNumber || order.id %></strong></a></td><td><div class="person-cell"><span class="avatar avatar-blue"><%= (order.customerName || 'C').slice(0,1).toUpperCase() %></span><%= order.customerName || '—' %></div></td><td><%= order.createdAt || '—' %></td><td><%= order.itemCount != null ? order.itemCount : '—' %></td><td class="amount"><%= order.total != null ? order.total : '—' %></td><td><span class="status"><%= order.status || '—' %></span></td><td><a class="icon-button" href="/orders/<%= order.id %>"><i data-lucide="arrow-up-right"></i></a></td></tr><% }) } else { %><tr><td colspan="7"><div class="table-empty"><strong>No orders yet</strong><span>Orders will appear here after you create them.</span></div></td></tr><% } %></tbody></table></div></section>
<%- include('../partials/layout-end') %>
