
<%- include('../partials/layout-start', {
  pageTitle: 'Orders',
  activePage: 'orders'
}) %>

<!-- Page Heading -->
<div class="page-heading">
  <div>
    <div class="eyebrow">SALES</div>
    <h1>Orders</h1>
    <p>View and manage customer orders.</p>
  </div>

  <a href="/orders/create" class="btn btn-primary">
    <i data-lucide="plus"></i>
    Create order
  </a>
</div>

<!-- Orders Table -->
<section class="panel table-panel">

  <div class="toolbar">
    <label class="table-search">
      <i data-lucide="search"></i>
      <input
        type="search"
        placeholder="Search order ID or customer..."
      >
    </label>

    <button type="button" class="btn btn-light">
      <i data-lucide="calendar"></i>
      Date range
    </button>

    <button type="button" class="btn btn-light">
      <i data-lucide="list-filter"></i>
      Status
    </button>
  </div>

  <div class="table-wrap">
    <table>

      <thead>
        <tr>
          <th>ORDER ID</th>
          <th>CUSTOMER</th>
          <th>DATE</th>
          <th>ITEMS</th>
          <th>TOTAL</th>
          <th>STATUS</th>
          <th></th>
        </tr>
      </thead>

      <tbody>

        <% const orderRows = (typeof orders !== 'undefined' && Array.isArray(orders)) ? orders : []; %>

        <% if (orderRows.length) { %>

          <% orderRows.forEach(order => { %>

            <tr>

              <!-- Order Number -->
              <td>
                <a class="order-id" href="/orders/<%= order.id %>">
                  <strong><%= order.order_number %></strong>
                </a>
              </td>

              <!-- Customer -->
              <td>
                <div class="person-cell">
                  <span class="avatar avatar-blue">
                    <%= (order.customer?.name || 'C').slice(0, 1).toUpperCase() %>
                  </span>

                  <%= order.customer?.name || 'Walk-in Customer' %>
                </div>
              </td>

              <!-- Order Date -->
              <td>
                <%= order.createdAt ? order.createdAt.toLocaleDateString() : '—' %>
              </td>

              <!-- Items Count -->
              <td>
                <%= order.items ? order.items.length : 0 %>
              </td>

              <!-- Total -->
              <td class="amount">
                <%= Number(order.total).toFixed(2) %>
              </td>

              <!-- Status -->
              <td>
                <span class="status">
                  <%= order.status || '—' %>
                </span>
              </td>

              <!-- Actions -->
              <td>
                <a
                  class="icon-button"
                  href="/orders/<%= order.id %>"
                  aria-label="View order details"
                  title="View order details"
                >
                  <i data-lucide="eye"></i>
                </a>
              </td>

            </tr>

          <% }) %>

        <% } else { %>

          <tr>
            <td colspan="7">
              <div class="table-empty">
                <strong>No orders yet</strong>
                <span>Orders will appear here after you create them.</span>
              </div>
            </td>
          </tr>

        <% } %>

      </tbody>

    </table>
  </div>

</section>

<%- include('../partials/layout-end') %>
