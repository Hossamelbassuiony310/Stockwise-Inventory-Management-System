
<%- include('../partials/layout-start', {
  pageTitle: 'Order Details',
  activePage: 'orders'
}) %>


<!-- Page Heading -->
<div class="page-heading">
  <div>
    <div class="eyebrow">SALES / ORDER DETAILS</div>
    <h1>Order Details</h1>
    <p>View order and customer information.</p>
  </div>

  <div style="display: flex; gap: 10px; flex-wrap: wrap;">

    <!-- Edit Order -->
    <a href="/orders/<%= order.id %>/edit" class="btn btn-primary">
      <i data-lucide="pencil"></i>
      Edit Order
    </a>

    <!-- Delete Order -->
    <form
      action="/orders/<%= order.id %>/delete"
      method="POST"
      onsubmit="return confirm('Are you sure you want to delete this order? This action cannot be undone.');"
    >
      <button type="submit" class="btn btn-danger">
        <i data-lucide="trash-2"></i>
        Delete Order
      </button>
    </form>

    <!-- Back to Orders -->
    <a href="/orders" class="btn btn-light">
      <i data-lucide="arrow-left"></i>
      Back to orders
    </a>

  </div>
</div>



  <div style="display: flex; gap: 10px; flex-wrap: wrap;">
    <a href="/orders" class="btn btn-light">
      <i data-lucide="arrow-left"></i>
      Back to orders
    </a>
  </div>
</div>

<!-- Order Information -->
<section class="panel" style="padding: 24px;">

  <div class="person-cell" style="margin-bottom: 24px;">
    <span class="avatar avatar-blue" style="width: 56px; height: 56px; font-size: 22px;">
      <i data-lucide="shopping-cart"></i>
    </span>

    <div>
      <h2 style="margin: 0;">
        <%= order.order_number %>
      </h2>

      <span class="eyebrow">
        ORDER #<%= order.id %>
      </span>
    </div>
  </div>

  <div class="detail-grid">

    <div class="field">
      <label>Customer</label>
      <p><%= order.customer ? order.customer.name : 'Walk-in Customer' %></p>
    </div>

    <div class="field">
      <label>Invoice Number</label>
      <p><%= order.invoice_number %></p>
    </div>

    <div class="field">
      <label>Order Date</label>
      <p>
        <%= order.createdAt ? order.createdAt.toLocaleDateString() : '—' %>
      </p>
    </div>

    <div class="field">
      <label>Status</label>
      <p><%= order.status %></p>
    </div>

    <div class="field">
      <label>Subtotal</label>
      <p><%= Number(order.subtotal).toFixed(2) %> EGP</p>
    </div>

    <div class="field">
      <label>Discount</label>
      <p>
        <%= Number(order.discount).toFixed(2) %>
        (<%= order.discount_type %>)
      </p>
    </div>

    <div class="field">
      <label>Total</label>
      <p>
        <strong><%= Number(order.total).toFixed(2) %> EGP</strong>
      </p>
    </div>

  </div>
</section>

<!-- Order Items -->
<section class="panel" style="padding: 24px; margin-top: 20px;">

  <div class="panel-header">
    <div>
      <h2>Order Items</h2>
      <p>Products included in this order.</p>
    </div>
  </div>

  <% if (items && items.length > 0) { %>

    <div class="table-wrap">
      <table class="data-table">

        <thead>
          <tr>
            <th>Product</th>
            <th>SKU</th>
            <th>Unit Price</th>
            <th>Quantity</th>
            <th>Line Total</th>
          </tr>
        </thead>

        <tbody>
          <% items.forEach((item) => { %>
            <tr>
              <td>
                <strong><%= item.product_name %></strong>
              </td>

              <td><%= item.sku %></td>

              <td>
                <%= Number(item.unit_price).toFixed(2) %> EGP
              </td>

              <td><%= item.quantity %></td>

              <td>
                <strong>
                  <%= Number(item.line_total).toFixed(2) %> EGP
                </strong>
              </td>
            </tr>
          <% }) %>
        </tbody>

      </table>
    </div>

  <% } else { %>

    <div class="table-empty">
      <strong>No order items available</strong>
      <span>This order does not contain any products.</span>
    </div>

  <% } %>

</section>

<%- include('../partials/layout-end') %>
