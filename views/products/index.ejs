
<%- include('../partials/layout-start', {pageTitle: 'Products', activePage: 'products'}) %>

<div class="page-heading">
  <div>
    <div class="eyebrow">CATALOG</div>
    <h1>Products</h1>
    <p>Manage your products, pricing, and stock levels.</p>
  </div>

  <a class="btn btn-primary" href="/products/new">
    <i data-lucide="plus"></i> Add product
  </a>
</div>

<section class="panel table-panel">
  <div class="toolbar">
    <label class="table-search">
      <i data-lucide="search"></i>
      <input type="search" placeholder="Search products...">
    </label>

    <button class="btn btn-light" type="button">
      <i data-lucide="list-filter"></i> Filter
    </button>

    <button class="btn btn-light" type="button">
      <i data-lucide="download"></i> Export
    </button>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th><input type="checkbox" aria-label="Select all"></th>
          <th>PRODUCT</th>
          <th>SKU</th>
          <th>CATEGORY</th>
          <th>PRICE</th>
          <th>STOCK</th>
          <th>STATUS</th>
          <th></th>
        </tr>
      </thead>

      <tbody>
        <% const productRows = (typeof products !== 'undefined' && Array.isArray(products)) ? products : []; %>

        <% if (productRows.length) { %>

          <% productRows.forEach((product) => { %>
            <tr>
              <td>
                <input type="checkbox" aria-label="Select product">
              </td>

              <td>
                <div class="product-cell">
                  <span class="product-thumb thumb-0">
                    <% if (product.image) { %>
                        <img
                        src="<%= product.image %>"
                        alt="<%= product.name %>"
                        class="product-image"
                        >
                    <% } else { %>
                        <i data-lucide="package"></i>
                    <% } %>
                  </span>

                  <strong>
                    <a href="/products/<%= product.id %>">
                      <%= product.name %>
                    </a>
                  </strong>
                </div>
              </td>

              <td>
                <span class="muted-code">
                  <%= product.sku || '—' %>
                </span>
              </td>

              <td>
                <%= product.category ? product.category.name : '—' %>
              </td>

              <td class="amount">
                <%= product.selling_price %>
              </td>

              <td>
                <strong><%= product.stock_quantity %></strong>
              </td>

              <td>
                <span class="status">
                  <%= product.stock_quantity === 0
                    ? 'Out of stock'
                    : product.stock_quantity <= product.low_stock_threshold
                      ? 'Low stock'
                      : 'In stock'
                  %>
                </span>
              </td>

              
              <td>
                <div class="table-actions">

                  <!-- View Product -->
                  <a
                    class="icon-button"
                    href="/products/<%= product.id %>"
                    title="View product"
                  >
                    <i data-lucide="eye"></i>
                  </a>

                  <!-- Edit Product -->
                  <a
                    class="icon-button"
                    href="/products/<%= product.id %>/edit"
                    title="Edit product"
                  >
                    <i data-lucide="pencil"></i>
                  </a>

                  <!-- Delete Product -->
                  <form
                    action="/products/<%= product.id %>/delete"
                    method="POST"
                    onsubmit="return confirm('Are you sure you want to delete this product?');"
                  >
                    <button
                      type="submit"
                      class="icon-button"
                      title="Delete product"
                    >
                      <i data-lucide="trash-2"></i>
                    </button>
                  </form>

                </div>
              </td>

            </tr>
          <% }) %>

        <% } else { %>

          <tr>
            <td colspan="8">
              <div class="table-empty">
                <strong>No products found</strong>
                <span>Products you add will appear in this table.</span>
              </div>
            </td>
          </tr>

        <% } %>
      </tbody>
    </table>
  </div>
</section>

<%- include('../partials/layout-end') %>
