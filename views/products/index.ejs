<%- include('../partials/layout-start', {pageTitle: 'Products', activePage: 'products'}) %>
<div class="page-heading"><div><div class="eyebrow">CATALOG</div><h1>Products</h1><p>Manage your products, pricing, and stock levels.</p></div><a class="btn btn-primary" href="/products/new"><i data-lucide="plus"></i> Add product</a></div>
<section class="panel table-panel"><div class="toolbar"><label class="table-search"><i data-lucide="search"></i><input type="search" placeholder="Search products..."></label><button class="btn btn-light" type="button"><i data-lucide="list-filter"></i> Filter</button><button class="btn btn-light" type="button"><i data-lucide="download"></i> Export</button></div><div class="table-wrap"><table><thead><tr><th><input type="checkbox" aria-label="Select all"></th><th>PRODUCT</th><th>SKU</th><th>CATEGORY</th><th>PRICE</th><th>STOCK</th><th>STATUS</th><th></th></tr></thead><tbody>
<% const productRows = (typeof products !== 'undefined' && Array.isArray(products)) ? products : []; %>
<% if (productRows.length) { productRows.forEach((product) => { %>
<tr><td><input type="checkbox" aria-label="Select product"></td><td><div class="product-cell"><span class="product-thumb thumb-0"><i data-lucide="package"></i></span><strong><%= product.name %></strong></div></td><td><span class="muted-code"><%= product.sku || '—' %></span></td><td><%= product.categoryName || '—' %></td><td class="amount"><%= product.price != null ? product.price : '—' %></td><td><strong><%= product.stock != null ? product.stock : '—' %></strong></td><td><span class="status"><%= product.status || '—' %></span></td><td><a class="icon-button" href="/products/<%= product.id %>/edit"><i data-lucide="more-horizontal"></i></a></td></tr>
<% }) } else { %><tr><td colspan="8"><div class="table-empty"><strong>No products found</strong><span>Products you add will appear in this table.</span></div></td></tr><% } %>
</tbody></table></div></section>
<%- include('../partials/layout-end') %>
